# =============================================================================
# TableTalk backend - variabili d'ambiente (ESEMPIO, solo valori segnaposto)
# =============================================================================
# DOVE METTERE IL FILE: server.js carica il .env dalla cartella SOPRA BACKEND/,
# cioè dalla radice del repository:  <repo>/.env   (NON <repo>/BACKEND/.env).
#   cp BACKEND/.env.example .env
# Le variabili già presenti nell'ambiente hanno la precedenza (override: false).
# Non committare mai il file .env (è in .gitignore).
#
# Legenda: [OBBLIGATORIA] serve per avviare/usare il backend;
#          [FACOLTATIVA] il backend parte anche senza (la funzione relativa non va).
# =============================================================================

# --- Base --------------------------------------------------------------------
# [FACOLTATIVA] development | production | test. In production validateEnv blocca valori Twilio "di test".
NODE_ENV=development
# [FACOLTATIVA] Porta HTTP del backend (default 5001).
PORT=5001
# [OBBLIGATORIA] Connessione MongoDB: senza, l'avvio si interrompe (config/db.js).
MONGO_URI=mongodb://127.0.0.1:27017/tabletalk-test
# [OBBLIGATORIA] Segreto per firmare i JWT. Senza, registrazione e login falliscono.
#   Usa una stringa casuale lunga (es. 64 caratteri), diversa per ogni ambiente.
JWT_SECRET=sostituisci-con-una-stringa-casuale-lunga

# --- URL e CORS --------------------------------------------------------------
# [FACOLTATIVA, consigliata] URL del frontend: link nelle email (verifica, reset, promemoria).
#   Senza, reset e verifica usano http://localhost:3000; i promemoria pasto via email falliscono.
FRONTEND_URL=http://localhost:3000
# [FACOLTATIVA] URL alternativo usato solo come ripiego nei link delle notifiche interattive.
APP_BASE_URL=http://localhost:3000
# [FACOLTATIVA] URL pubblico dell'API; aggiunto alle origini consentite da Socket.IO.
API_URL=http://localhost:5001
# [FACOLTATIVA] Origini CORS consentite, separate da virgola. http://localhost:3000 e
#   capacitor://localhost sono già consentite di default.
CORS_ORIGIN=http://localhost:3000

# --- Email (SMTP) ------------------------------------------------------------
# [FACOLTATIVE] Senza SMTP il backend parte; le email (verifica, reset, inviti,
#   promemoria, segnalazioni) non vengono inviate e l'errore finisce nei log.
SMTP_HOST=
SMTP_PORT=587
# true per la porta 465 (TLS diretto), false altrimenti.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Mittente delle email (es. noreply@example.com).
EMAIL_FROM=
# Indirizzo di supporto mostrato in alcuni template.
SUPPORT_EMAIL=

# --- Admin e segnalazioni ----------------------------------------------------
# [FACOLTATIVA] Doppio uso:
#   1) destinatario delle email sulle segnalazioni (default: indirizzo nel codice);
#   2) email dell'admin creato da scripts/createAdmin.js e config/seeds.js.
ADMIN_EMAIL=admin@example.test
# [Solo per createAdmin.js / config/seeds.js] Password dell'admin di prova, almeno 12 caratteri.
#   Meglio passarla solo sulla riga di comando che salvarla qui.
ADMIN_PASSWORD=
# [FACOLTATIVA] Link al pannello admin nelle email sulle segnalazioni.
ADMIN_DASHBOARD_URL=http://localhost:3000/#/admin/reports

# --- Firebase (push e immagini) ----------------------------------------------
# [FACOLTATIVE] Senza credenziali il backend parte (Firebase inizializzato senza
#   credenziali): notifiche push e upload immagini non funzionano (l'errore è nei log,
#   i pasti vengono creati senza immagine). Usa UNO dei due metodi.
# Metodo 1: JSON completo dell'account di servizio su una riga.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Metodo 2: campi separati.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_CLIENT_ID=
# Bucket per le immagini (default: bucket del progetto di produzione nel codice).
FIREBASE_STORAGE_BUCKET=
# Icone usate nelle notifiche push web/iOS.
APP_LOGO_URL=
APP_BADGE_URL=

# --- Twilio (videochiamate) --------------------------------------------------
# [FACOLTATIVE] Senza, il backend parte; il token video risponde 500 e la stanza
#   non viene creata. Se valorizzato, TWILIO_ACCOUNT_SID deve iniziare con "AC".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=

# --- Altri servizi -----------------------------------------------------------
# [FACOLTATIVA] Redis per Socket.IO con più istanze (es. redis://localhost:6379).
REDIS_URL=
# [FACOLTATIVA] Chiave Google Geocoding per PUT /api/users/me/location-from-coords
#   (nome con questa ortografia nel codice).
Maps_API_KEY=

# --- Job pianificati -----------------------------------------------------------
# [FACOLTATIVE] Riepiloghi email settimanali/mensili. In locale e finché le
#   statistiche non sono reali (audit COM-01) tenerli disattivati.
ENABLE_WEEKLY_SUMMARY=false
ENABLE_MONTHLY_SUMMARY=false
WEEKLY_SUMMARY_SCHEDULE=0 9 * * 1
MONTHLY_SUMMARY_SCHEDULE=0 10 1 * *
WEEKLY_SUMMARY_DAY=monday
WEEKLY_SUMMARY_HOUR=9
MONTHLY_SUMMARY_DAY=1
MONTHLY_SUMMARY_HOUR=10
SUMMARY_EMAILS_BATCH_SIZE=50
SUMMARY_EMAILS_BATCH_DELAY=1000
# Pulizia token di verifica scaduti (il job non viene avviato da server.js).
EMAIL_VERIFICATION_CLEANUP_ENABLED=true
EMAIL_VERIFICATION_CLEANUP_SCHEDULE=0 2 * * *

# --- Solo script di manutenzione (BACKEND/scripts) ---------------------------
# Usati da seeds.js / cleanDatabase.js, che rifiutano NODE_ENV=production.
# Password degli utenti di prova creati dai seed (almeno 12 caratteri).
SEED_USER_PASSWORD=
# "yes" per confermare le operazioni distruttive (in alternativa: --confirm).
CONFIRM_DESTRUCTIVE=
# Alias accettato solo se uguale a MONGO_URI (gli script falliscono se sono diversi).
MONGODB_URI=
