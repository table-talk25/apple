# File: .gitignore (nella cartella principale)

# --- AGGIUNTE DI SICUREZZA ---

# File di configurazione sensibili
.env
/BACKEND/.env
/FRONTEND/client/.env
/android/app/google-services.json
/BACKEND/firebase-service-account.json

# Keystore di firma Android
*.keystore
/GOOGLE_PLAY_RELEASE/

# File di proprietà locali (che conterranno le password)
key.properties
/FRONTEND/client/android/key.properties
node_modules

# Cartelle di backup e duplicati
app_old_backup/
android_old_backup_duplicate/

# File IDE
.idea/
*.iml
.DS_Store

# Cartelle temporanee di archivio post-cleanup
_ARCHIVE_DELETE_AFTER_REVIEW/

# IDE config — per-developer, non condividere
.idea/
.vscode/
