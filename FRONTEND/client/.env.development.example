# Configurazione per `npm start` in locale (solo sviluppo).
# Copia questo file in .env.development.local (ignorato da git):
#   cp .env.development.example .env.development.local
#
# Con NODE_ENV=development (npm start) REACT_APP_API_URL ha la precedenza
# sull'URL di produzione scritto in public/config.js.
# Non influisce su `npm run build` (produzione/Android).
#
# Backend locale (docker compose o `npm run dev` in BACKEND/):
REACT_APP_API_URL=http://localhost:5001/api
#
# Live reload su un dispositivo/emulatore Android: "localhost" è il telefono stesso.
# Usa l'IP del computer (es. http://192.168.1.10:5001/api) oppure, per l'emulatore,
# http://10.0.2.2:5001/api.
